# .env.example — скопируй в .env и заполни своими значениями

# База данных
DATABASE_URL=postgresql+asyncpg://admin:password@db:5432/hse_rag

# Redis
REDIS_URL=redis://redis:6379/0

# Google Drive
GOOGLE_DRIVE_FOLDER_ID=your_folder_id_here
GOOGLE_APPLICATION_CREDENTIALS=google_creds.json

# Настройки AI моделей
EMBEDDER_MODEL_NAME=mixedbread-ai/mxbai-embed-large-v1
CHUNK_SIZE=1000
CHUNK_OVERLAP=100

# Выбор LLM для Chat Service (stub | openai | ollama)
LLM_PROVIDER=stub
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=llama3
